            "network_config": "",
            "pool": "pool_a",
            "user_data": "#cloud-config\n\n# Update packages on first boot\npackage_update: true\npackage_upgrade: true\n\n# Set the default user and add your SSH key so you can log in\nusers:\n  - name: sysadmin\n    groups: wheel\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    ssh_authorized_keys:\n      - ssh-rsa  aw7@almalinuxaw7\n # We will pass this in from Terraform\n\n# Set the hostname (passed from Terraform)\nhostname: pa-node-1\nfqdn: pa-node-1.localdomain\nmanage_etc_hosts: true\n\n# Keep ssh configuration clean\nssh_pwauth: false\ndisable_root: true\n"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA==",
          "dependencies": [
            "libvirt_pool.pool_a"
          ]
